{
  "name": "search_index",
  "type": "search",
  "definition": {
    "analyzer": "lucene.standard",
    "searchAnalyzer": "lucene.standard",
    "mappings": {
      "dynamic": false,
      "fields": {
        "title": [
          {
            "type": "string",
            "analyzer": "lucene.standard"
          },
          {
            "type": "autocomplete",
            "analyzer": "lucene.standard",
            "tokenization": "edgeGram",
            "minGrams": 2,
            "maxGrams": 15,
            "foldDiacritics": true
          }
        ],
        "description": {
          "type": "string",
          "analyzer": "lucene.standard"
        },
        "domain": {
          "type": "token"
        },
        "source": {
          "type": "token"
        }
      }
    },
    "storedSource": {
      "include": ["title", "domain", "source"]
    }
  }
}
